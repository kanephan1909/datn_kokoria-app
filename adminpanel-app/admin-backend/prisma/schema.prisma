generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
}

//
// =================== USER ===================
//
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String?
  googleId    String?
  phone       String?
  role        Role     @default(USER)
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  carts     Cart[]
}

enum Role {
  USER
  ADMIN
  DRIVER // shipper
}

//
// =================== ADDRESS ===================
//
model Address {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String  @db.ObjectId
  type         String
  name         String
  mobile       String
  flatNo       String?
  street       String?
  landmark     String?
  buildingName String?
  pincode      String?
  locality     String?

  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])
}

//
// =================== RESTAURANT (1 nhà hàng nhưng chuẩn để mở rộng) ===================
//
model Restaurant {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String
  latitude  Float
  longitude Float

  openTime  String?
  closeTime String?
  isOpen    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// =================== CATEGORY ===================
//
model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

//
// =================== PRODUCT ===================
//
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  imageUrl    String?
  description String?
  price       Float
  stock       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.ObjectId
}

//
// =================== DRIVER (SHIPPER) ===================
//
model Driver {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String   @unique
  avatar      String?
  isOnline    Boolean  @default(false)
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currentLat Float?
  currentLng Float?

  orders    Order[]
  locations DriverLocation[]
}

//
// ========== DRIVER LOCATION HISTORY (REALTIME TRACKING) ==========
//
model DriverLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId  String   @db.ObjectId
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
}

//
// =================== ORDER ===================
//
model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  items       Json[]
  totalAmount Float
  note        String?
  status      OrderStatus @default(PENDING)

  shippingDistance Float?
  shippingFee      Float?
  restaurantLat    Float?
  restaurantLng    Float?

  confirmedAt  DateTime?
  preparedAt   DateTime?
  readyAt      DateTime?
  pickedUpAt   DateTime?
  deliveringAt DateTime?
  deliveredAt  DateTime?
  canceledAt   DateTime?

  paymentStatus PaymentStatus @default(PAYMENT_PENDING)

  address Json
  user    User @relation(fields: [userId], references: [id])

  // shipper
  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String? @db.ObjectId

  createdAt DateTime @default(now())

  // PAYMENT — giữ nguyên theo schema của bạn
  paymentMethod String  @default("ONLINE")
  paymentId     String?

  zalopayOrderId                       String?
  zalopayPaymentId                     String?
  zalopayPaymentStatus                 String?
  zalopayPaymentDate                   DateTime?
  zalopayPaymentAmount                 Float?
  zalopayPaymentCurrency               String?
  zalopayPaymentGateway                String?
  zalopayPaymentGatewayResponse        Json?
  zalopayPaymentGatewayResponseMessage String?
  zalopayPaymentGatewayResponseCode    String?

  momopayOrderId                       String?
  momopayPaymentId                     String?
  momopayPaymentStatus                 String?
  momopayPaymentDate                   DateTime?
  momopayPaymentAmount                 Float?
  momopayPaymentCurrency               String?
  momopayPaymentGateway                String?
  momopayPaymentGatewayResponse        Json?
  momopayPaymentGatewayResponseMessage String?
  momopayPaymentGatewayResponseCode    String?

  logs     OrderLog[]
  messages Message[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERING
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
}

//
// ========== ORDER LOG (LỊCH SỬ trạng thái giống Grab) ==========
//
model OrderLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  oldStatus String?
  newStatus String
  message   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

//
// =================== CART (tuỳ chọn) ===================
//
model Cart {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  items  Json[]

  user User @relation(fields: [userId], references: [id])
}

//
// =================== VOUCHER ===================
//
model Voucher {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  discount  Float
  minOrder  Float?
  maxDeduct Float?
  expiry    DateTime
  createdAt DateTime @default(now())
}

//
// =================== CHAT (KHÁCH ↔ SHIPPER) ===================
//
model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  senderId  String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
