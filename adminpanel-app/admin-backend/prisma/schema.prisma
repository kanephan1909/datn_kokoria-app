generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//
// =================== USER ===================
//
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String?
  googleId    String?
  facebookId  String?
  appleId     String?
  phone       String?
  avatarUrl   String?
  role        Role     @default(USER)
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  carts     Cart[]
  ratings   Rating[]
}

enum Role {
  USER
  ADMIN
  DRIVER // shipper
}

//
// =================== ADDRESS ===================
//
model Address {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String  @db.ObjectId
  type         String
  name         String
  mobile       String
  flatNo       String?
  street       String?
  landmark     String?
  buildingName String?
  pincode      String?
  locality     String?

  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id])
}

//
// =================== RESTAURANT (1 nhà hàng nhưng chuẩn để mở rộng) ===================
//
model Restaurant {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String
  latitude  Float
  longitude Float

  openTime  String?
  closeTime String?
  isOpen    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

//
// =================== CATEGORY ===================
//
model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]
}

//
// =================== PRODUCT ===================
//
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  imageUrl    String?
  description String?
  price       Float
  stock       Int
  isActive    Boolean  @default(true)
  variants    Json? // Lưu variants dưới dạng JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.ObjectId
}

//
// =================== DRIVER (SHIPPER) ===================
//
model Driver {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String   @unique
  avatar      String?
  isOnline    Boolean  @default(false)
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  currentLat Float?
  currentLng Float?

  orders    Order[]
  locations DriverLocation[]
  ratings   Rating[]
}

//
// ========== DRIVER LOCATION HISTORY (REALTIME TRACKING) ==========
//
model DriverLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId  String   @db.ObjectId
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])
}

//
// =================== ORDER ===================
//
model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  items       Json[]
  totalAmount Float
  note        String?
  status      OrderStatus @default(PENDING)

  shippingDistance Float?
  shippingFee      Float?
  restaurantLat    Float?
  restaurantLng    Float?

  confirmedAt  DateTime?
  preparedAt   DateTime?
  readyAt      DateTime?
  pickedUpAt   DateTime?
  deliveringAt DateTime?
  deliveredAt  DateTime?
  canceledAt   DateTime?

  // Trạng thái thanh toán tổng quát cho đơn
  paymentStatus PaymentStatus @default(PAYMENT_PENDING)
  paymentMethod PaymentMethod @default(ONLINE)

  address   Json
  createdAt DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id])
  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String? @db.ObjectId

  // Quan hệ tới các bản ghi thanh toán chi tiết
  payments Payment[]
  logs     OrderLog[]
  messages Message[]
  rating   Rating?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERING
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
}

enum PaymentMethod {
  ONLINE // thanh toán qua cổng (MoMo, ZaloPay, VNPAY,…)
  COD // thanh toán khi nhận hàng
}

enum PaymentProvider {
  MOMO
  ZALOPAY
  VNPAY
  CASH // cho COD / thanh toán trực tiếp
  OTHER
}

//
// ========== PAYMENT (chi tiết thanh toán từng lần) ==========
model Payment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId

  provider PaymentProvider // MOMO / ZALOPAY / CASH / OTHER
  method   PaymentMethod // ONLINE / COD
  status   PaymentStatus   @default(PAYMENT_PENDING)

  amount   Float
  currency String? @default("VND")

  // Thông tin từ cổng thanh toán
  gatewayOrderId  String? // orderId phía gateway (MoMo/ZaloPay)
  gatewayTransId  String? // transaction/payment id
  gatewayCode     String? // mã lỗi / mã trạng thái
  gatewayMessage  String? // message mô tả
  gatewayResponse Json? // full JSON response để debug/log

  paidAt    DateTime? // thời điểm thanh toán thành công
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

//
// ========== ORDER LOG (LỊCH SỬ trạng thái giống Grab) ==========
//
model OrderLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  oldStatus String?
  newStatus String
  message   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

//
// =================== CART (tuỳ chọn) ===================
//
model Cart {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  items  Json[]

  user User @relation(fields: [userId], references: [id])
}

//
// =================== VOUCHER ===================
//
model Voucher {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  discount  Float
  minOrder  Float?
  maxDeduct Float?
  expiry    DateTime
  createdAt DateTime @default(now())
}

//
// =================== CHAT (KHÁCH ↔ SHIPPER) ===================
//
model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  senderId  String   @db.ObjectId
  text      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

//
// =================== RATING (ĐÁNH GIÁ TÀI XẾ) ===================
//
model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  userId    String   @db.ObjectId
  driverId  String   @db.ObjectId
  rating    Int      // 1-5 sao
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
}
